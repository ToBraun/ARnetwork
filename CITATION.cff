date-released: "2026-05-27" # update to the actual release date
keywords:
  - atmospheric rivers
  - complex networks
  - climate dynamics
  - extreme precipitation
  - ERA5
  - PIKART
  - directed weighted graphs
  - H3 hexagonal grid
  - transport networks
  - atmospheric science
